# API (optional overrides)
# EXPO_PUBLIC_API_PRODUCTION=https://production-api25.become-hub.com
# EXPO_PUBLIC_API_STAGING=https://staging-api25.become-hub.com

# Spike: POST destination for full PPI/RR session track after Ably endSession / debug flush.
# Leave empty for dry-run (log only). Auth: Authorization Bearer {device session token}.
EXPO_PUBLIC_TRACK_UPLOAD_URL=

# Sentry (org: stridegate, project: react-native)
# Client DSN from Project Settings → Client Keys (DSN). Required at runtime for logging.
EXPO_PUBLIC_SENTRY_DSN=

# Auth token for uploading source maps during native/EAS builds. Do not commit real tokens.
# Create at https://sentry.io/settings/account/api/auth-tokens/
# SENTRY_AUTH_TOKEN=
